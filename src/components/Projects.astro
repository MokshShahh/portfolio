---
import PixelCard from "./pixelCard.jsx";
import { ExternalLink } from "lucide-react";

interface project {
  title: string;
  description: string;
  tech: string[];
  live: string;
  github: string;
}
interface Props {
  projects: project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="px-6 bg-black">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-16">
      {
        projects.map((project) => (
          <div class="group relative aspect-4/5">
            {/* @ts-ignore */}
            <PixelCard
              client:only
              className="w-full h-full"
              variant="blue"
              gap={8}
            >
              <div class="absolute inset-0 p-8 flex flex-col text-white z-10 pointer-events-none">
                <h3 class="text-lg font-pixel mb-4 pointer-events-auto leading-tight">
                  {project.title}
                </h3>

                <div class="mb-6 pointer-events-auto">
                  <div class="flex flex-wrap gap-2">
                    {project.tech.map((t) => (
                      <span class="border border-white/10 px-2 py-1 text-xs font-mono text-white/70 bg-white/2">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>

                <p class="text-sm font-mono text-white/70 mb-8 pointer-events-auto leading-relaxed">
                  {project.description}
                </p>

                <div class="mt-auto flex gap-4 pointer-events-auto">
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group/icon border border-white/10 p-3 hover:bg-white transition-all duration-300 flex items-center justify-center aspect-square relative"
                    title="GitHub Repository"
                  >
                    <img
                      src="github.svg"
                      alt="GitHub"
                      class="w-6 h-6 group-hover/icon:opacity-0 transition-opacity"
                    />
                    <img
                      src="github-dark.png"
                      alt="GitHub"
                      class="w-6 h-6 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 group-hover/icon:opacity-100 transition-opacity"
                    />
                  </a>
                  {project.live && (
                    <a
                      href={project.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border border-white/10 p-3 hover:bg-white hover:text-black transition-all duration-300 flex items-center justify-center aspect-square"
                      title="Live Demo"
                    >
                      <ExternalLink size={18} />
                    </a>
                  )}
                </div>
              </div>
            </PixelCard>
          </div>
        ))
      }
    </div>
  </div>
</section>
